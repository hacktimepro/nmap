            VALUE "FileVersion", "10.0.19041.1\0"
            VALUE "InternalName", "netdiag\0"
            VALUE "LegalCopyright", "Copyright (c) Microsoft Corporation. All rights reserved.\0"
            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "netdiag.exe\0"
            VALUE "ProductName", "Microsoft Windows Operating System\0"
            VALUE "ProductVersion", "10.0.19041.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

